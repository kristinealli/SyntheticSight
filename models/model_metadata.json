{
  "project": "Synthetic Sight",
  "task": "Binary supervised image classification: Real (0) vs Fake/Synthetic (1)",
  "dataset": {
    "name": "140k Real and Fake Faces",
    "kaggle_slug": "xhlulu/140k-real-and-fake-faces",
    "train_images": 100000,
    "validation_images": 20000,
    "test_images": 20000,
    "real_source": "FFHQ",
    "synthetic_source": "StyleGAN"
  },
  "model": {
    "architecture": "ResNet-50",
    "pretraining": "ImageNet",
    "input_size": [
      224,
      224
    ],
    "labels": {
      "Real": 0,
      "Fake": 1
    },
    "classifier_head": {
      "input_features": 2048,
      "hidden_units": 256,
      "batch_normalization": true,
      "activation": "ReLU",
      "dropout": 0.3,
      "output_features": 1
    },
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    }
  },
  "training": {
    "seed": 13,
    "batch_size": 32,
    "max_epochs": 15,
    "head_only_epochs": 3,
    "fine_tuned_module": "layer4",
    "optimizer": "Adam",
    "head_learning_rate": 0.0005,
    "layer4_learning_rate": 1e-05,
    "weight_decay": 0.0001,
    "loss": "BCEWithLogitsLoss",
    "augmentation": {
      "training_only": true,
      "horizontal_flip_probability": 0.5,
      "color_jitter": {
        "brightness": 0.1,
        "contrast": 0.1,
        "saturation": 0.1,
        "hue": 0.02
      }
    }
  },
  "selection": {
    "implemented_monitor": "Fake F1",
    "threshold_objective": "Maximize validation Fake F1 over 0.05-0.95 in 0.01 increments; ties nearest 0.50",
    "selected_epoch": 13,
    "decision_threshold": 0.51,
    "reconciliation_note": "The training code monitored validation Fake F1. Epoch 13 also had the lowest recorded validation loss, so the implementation and final presentation identify the same checkpoint."
  },
  "final_test": {
    "evaluation_split": "Test",
